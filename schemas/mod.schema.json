{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aamod 插件清单（开发者预览）",
  "type": "object",
  "required": [
    "id",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[^\\\\/:]+\\.dll$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "api_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "default": 1
    },
    "min_api_size": {
      "type": "integer",
      "minimum": 128,
      "maximum": 4294967295,
      "default": 128
    },
    "required_capabilities": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "default": 0
    }
  },
  "additionalProperties": false
}
